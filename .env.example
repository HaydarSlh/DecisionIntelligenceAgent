# LLM provider — set to "gemini" for this RAG build
LLM_PROVIDER="gemini"

# Gemini
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash	"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001	"

# Vector store
CHROMA_PATH="./chroma_data"

# Logs
LOGS_DIR="./logs"

# Thread-based RAG
TWCS_PARQUET_PATH="./dataset/processed/twcs_raw.parquet"
THREAD_MAX_CHARS="4000"
THREAD_MIN_MESSAGES="2"
THREAD_INGEST_LIMIT="10"
RAG_TOP_K="5"

# Frontend CORS origins (comma-separated)
CORS_ORIGINS="localhost:5173,localhost:8080	"
